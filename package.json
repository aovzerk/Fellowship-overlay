{
  "name": "fellowship-overlay",
  "version": "1.6.2",
  "description": "Fellowship overlay",
  "main": "dist/main/index.js",
  "author": "AOV",
  "private": true,
  "scripts": {
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win=portable",
    "tauri:app:prepare": "node scripts/prepare-tauri-app-ui.js",
    "tauri:app:dev": "npm run build && npm run tauri:app:prepare && tauri dev",
    "tauri:app:build": "npm run build && npm run tauri:app:prepare && tauri build",
    "tauri:app:package": "node scripts/package-tauri-portable.js",
    "build": "tsc",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "eslint": "^9.22.0",
    "typescript": "^5.8.3"
  },
  "build": {
    "appId": "com.aov.fellowshipoverlay",
    "productName": "Fellowship Overlay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*",
      "game-data/**/*",
      "icons/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Fellowship-Overlay-Setup-${version}.${ext}",
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "icons/icon.ico",
      "uninstallerIcon": "icons/icon.ico",
      "installerHeaderIcon": "icons/icon.ico"
    },
    "portable": {
      "artifactName": "Fellowship Overlay.exe"
    }
  }
}
